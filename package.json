{
  "name": "xinzhe.dev",
  "description": "Xinzhe's personal website, powered by Next.js and Notion.",
  "author": {
    "name": "Xinzhe",
    "url": "https://xinzhe.dev"
  },
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prettier": "prettier --write \"**/*.{html,js,json,md,mdx,mjs}\"",
    "clear-cache": "rm -rf .next",
    "unused": "next-unused",
    "lint": "eslint src",
    "test": "node --test tests/*.test.mjs",
    "translate": "node --env-file-if-exists=.env.local scripts/translate.mjs",
    "translate:review": "node scripts/review-translation.mjs",
    "translate:worker": "node --env-file-if-exists=.env.local scripts/translation-admin-worker.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "classix": "^2.2.21",
    "cssnano": "^9.9.0",
    "feed": "^6.0.0",
    "framer-motion": "^14.7.1",
    "geist": "^1.8.2",
    "lucide-react": "^1.63.0",
    "markdown-to-jsx": "^9.10.3",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-tweet": "^3.3.1",
    "react-wrap-balancer": "^1.1.1",
    "server-only": "^0.0.1",
    "sugar-high": "^2.6.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "next-unused": "^0.0.6",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3"
  },
  "next-unused": {
    "debug": true,
    "include": [
      "src"
    ],
    "entrypoints": [
      "src"
    ]
  },
  "packageManager": "npm@12.2.1",
  "allowScripts": {
    "unrs-resolver": true
  },
  "overrides": {
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "homepage": "https://xinzhe.dev"
}
