# 站点正式域名；本地测试绝对链接时可改为 http://localhost:3000。
NEXT_PUBLIC_SITE_URL=https://xinzhe.dev

# Notion content backend (server-only; connect the new backend page to this integration)
NOTION_API_TOKEN=
NOTION_PROJECTS_DATA_SOURCE_ID=b7c54199-6549-4162-a009-8457edb0a5cb
NOTION_THOUGHTS_DATA_SOURCE_ID=43203c99-ea47-41d7-bd13-9953c14b2357
NOTION_POSTS_DATA_SOURCE_ID=5450b578-e312-44fd-b431-e8c2e43f36f8
NOTION_PAGES_DATA_SOURCE_ID=991f7575-565e-4821-bbcc-631218e318dd
NOTION_JOURNEY_DATA_SOURCE_ID=390f6b41-8754-46a3-8aec-117e273222ff
# Random secret for /api/draft?secret=...&slug=/writing/your-slug
NOTION_PREVIEW_SECRET=

# For retrieving view counts on writings
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# For on-demand revalidation
NEXT_REVALIDATE_SECRET=

# For Tinybird Analytics
NEXT_PUBLIC_TINYBIRD_TOKEN=

# Server/worker only. DeepSeek selected; model ID is explicit and replaceable.
TRANSLATION_API_KEY=
# Alternatively: DEEPSEEK_API_KEY=
TRANSLATION_BASE_URL=https://api.deepseek.com
# Check provider model availability before selecting a model.
TRANSLATION_MODEL=

# Translation admin. Use a random dedicated secret of at least 24 characters.
TRANSLATION_ADMIN_PASSWORD=
# local for development/self-hosted durable disk; github for Vercel
TRANSLATION_ADMIN_BACKEND=github
TRANSLATION_GITHUB_TOKEN=
TRANSLATION_GITHUB_REPOSITORY=XinzheGao/xinzhe.dev
TRANSLATION_GITHUB_BRANCH=main
# Optional: request a deployment after a manual review has been committed.
VERCEL_DEPLOY_HOOK=
